generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now())
  orders       Order[]
}

model Order {
  id           String      @id @default(cuid())
  userId       String?
  user         User?       @relation(fields: [userId], references: [id])
  customerName String
  phone        String
  email        String?
  city         String
  np           String
  payment      String
  comment      String?
  total        Int
  status       String      @default("new")
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  title     String
  size      String?
  price     Int
  quantity  Int
}

model CallbackRequest {
  id        String   @id @default(cuid())
  name      String
  phone     String
  topic     String?
  comment   String?
  source    String?
  status    String   @default("new")
  createdAt DateTime @default(now())
}
